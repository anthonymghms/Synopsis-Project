# Install as /etc/paragospels/app.env, owned by root with mode 0600.
# systemd reads this file; the service reads the credential file separately.
FIREBASE_SERVICE_ACCOUNT=/etc/paragospels/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/paragospels/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=synopsis-224b0.firebasestorage.app
CORS_ORIGINS=https://paragospels.com,https://www.paragospels.com
MAX_ADMIN_UPLOAD_BYTES=33554432
FLASK_DEBUG=0
